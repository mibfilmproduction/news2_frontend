# Frontend Environment Variables
# Copy this file to .env for development or .env.production for production

# API Configuration
VITE_API_URL=http://localhost:5003/api
VITE_MEDIA_URL=http://localhost:5003/uploads

# Site Configuration
VITE_SITE_URL=http://localhost:80
VITE_DEFAULT_LANGUAGE=hindi
VITE_ENABLE_SERVICE_WORKER=true

# Analytics (optional)
VITE_ANALYTICS_ID=

# Instagram API (optional)
VITE_INSTAGRAM_ACCESS_TOKEN=DUMMY_TOKEN