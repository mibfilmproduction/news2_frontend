# Frontend Environment Variables
# Copy this file to .env for development or .env.production for production

# API Configuration
VITE_API_URL=http://localhost:5003/api
VITE_MEDIA_URL=http://localhost:5003/uploads

# Site Configuration
VITE_SITE_URL=http://localhost:8080
VITE_DEFAULT_LANGUAGE=hindi
VITE_ENABLE_SERVICE_WORKER=false

# Analytics (optional - leave empty until real ID)
VITE_ANALYTICS_ID=

# Instagram API (optional - leave empty, do not ship DUMMY_TOKEN)
VITE_INSTAGRAM_ACCESS_TOKEN=

# Cricket API (optional)
VITE_CRICKET_API_KEY=
VITE_APP_VERSION=1.0.0
VITE_SENTRY_DSN=