# Frontend Development Environment Variables

# API Configuration (Backend runs on port 5003)
VITE_API_URL=http://localhost:5003/api
VITE_MEDIA_URL=http://localhost:5003/uploads

# Site Configuration (Frontend runs on port 80 via Nginx, or 5173 via Vite dev server)
VITE_SITE_URL=http://localhost
VITE_DEFAULT_LANGUAGE=hindi
VITE_ENABLE_SERVICE_WORKER=false

# Analytics (optional - add your GA4 ID)
VITE_ANALYTICS_ID=

# Instagram API (optional)
VITE_INSTAGRAM_ACCESS_TOKEN=DUMMY_TOKEN

# Cricket API (optional)
VITE_CRICKET_API_KEY=